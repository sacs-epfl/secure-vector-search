data/*
!data/.gitkeep
# Plan 24 W2: track the 8.8M corpus's CHECKSUMS.txt artefact while leaving
# the heavy embeddings + jsonl + symlinks (to /scratch/svs-data/msmarco-full/)
# ignored. The dir itself must be un-ignored before file-level rules can
# match what's inside it.
!data/msmarco-full/
data/msmarco-full/*
!data/msmarco-full/CHECKSUMS.txt
/target
# Local Python virtualenv (analysis/embedding deps; requirements.txt is the
# tracked source of truth). Per-host, never tracked.
venv/
# Per-host cargo config (Plan 21 Phase A opt-in). The .example file
# IS tracked; the live .cargo/config.toml that a producer copies it
# to is local-only so per-host codegen choices don't enter git.
/.cargo/config.toml
Cargo.lock
*.pdf
analysis/data/*
!analysis/data/.gitkeep
analysis/output/*
!analysis/output/.gitkeep
# latexmk produces files here when invoked with `-cd -outdir=...` from
# analysis/figures/ (the resolved outdir lands inside `figures/`, not
# beside it). Derivable from figures/*.tex + aggregated TSVs.
analysis/figures/output/
analysis/cross_machine/data/
analysis/cross_machine/output/
# Per-checkout secrets resolved by deploy/notify.sh — never tracked.
.slack-webhook
# Per-machine append-only run log: every eval invocation tacks on
# a row, so cross-machine merge conflicts on `git pull` are
# guaranteed. pull_results.py is the cross-machine merge channel
# for index.csv; git is not. machines.csv stays tracked because
# its `machine-name` column is hand-curated (sacs006, mini, …)
# and worth sharing across checkouts.
results/index.csv
# results/ is version-controlled per ADR 004; no blanket ignore here
.DS_Store
__pycache__/
*.pyc
# tmp/ is local scratch (Tiptoe Go-ref clones pinned in
# tools/tiptoe-go-rev, killed-run snapshots, Slack-notify logs,
# extracted PDF text, etc.). Blanket-ignore — nothing in here is
# meant to be tracked; ADR 009 / Plan 22's archival channel is
# the bulk store, not tmp/.
tmp/
# Plan 22 W3 per-machine `make preprocess` output — derived from
# raw.csv (which itself lives in the bulk store per ADR 009).
# These are regenerable via `make preprocess MACHINE=<id>`; tracking
# them just generates churn on every report build.
#
# NOT ignored: hand-authored `*-finding.tex` notes (see
# report.py::_finding_input). Those are per-machine prose that
# travels with the data and is the whole reason the aggregated dir
# isn't blanket-ignored anymore.
results/aggregated/**/*.tsv
results/aggregated/**/.preprocessed
# Per-machine `make report` output — report.pdf + report.tex + the
# data/ + figures/ subdirs. All derived from results/aggregated/<m>/
# via report.py; regenerated by `make report` (or `make finalize`).
# Hand-authored per-snapshot findings (italicised prose scoped to a
# snapshot's (scheme, run-id) source set) are the one tracked
# exception — see analysis/report.py::_finding_input. git won't
# descend into a fully-ignored directory, so the parent dirs are
# explicitly un-ignored before the all-files exclusion + the
# finding re-inclusion.
results/runs/*/reports/**
!results/runs/*/reports/
!results/runs/*/reports/*/
!results/runs/*/reports/*/data/
!results/runs/*/reports/*/data/*-finding.tex
# script(1) shell-session captures (typically `script ./typescript`
# while debugging interactive flows).
typescript
# Bulked-and-pruneable per-run artifacts. raw.csv / top_k.csv /
# substep-breakdown.csv live in the bulk store (ADR 009); local
# copies are transient hydrates that preprocess.py / tiptoe_diff.py
# fetch on demand. Tiptoe-Go intermediates (emb.csv, queries.csv,
# paired-*.csv) are regenerated by tiptoe_go_runner from the corpus.
# Pre-Plan-22 raw.csvs already tracked stay tracked — gitignore is
# only for new untracked-ones.
results/runs/**/raw.csv
results/runs/**/top_k.csv
results/runs/**/substep-breakdown.csv
results/runs/**/emb.csv
results/runs/**/queries.csv
results/runs/**/paired-out.csv
results/runs/**/paired-timing.csv

# Local audit bulk-hydration scratch (raw.csv pulled from bulk store)
.audit-hydrate/
