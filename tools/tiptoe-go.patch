+"""Generate a tiny clustered embeddings CSV + queries CSV for paired-runner smoke testing.
+
+Format must match search/corpus/read_clustered.go and the queries reader in main.go.
+"""
+import argparse
+import csv
+import math
+import os
+import random
+
+
+def write_emb(path: str, *, num_clusters: int, docs_per_cluster: int,
+              slots: int, slot_bits: int, seed: int) -> None:
+    rng = random.Random(seed)
+    lo = -(1 << (slot_bits - 1))
+    hi = (1 << (slot_bits - 1))
+    num_docs = num_clusters * docs_per_cluster
+
+    with open(path, "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow([str(num_docs)])
+        w.writerow([str(slots)])
+        w.writerow([str(slot_bits)])
+        w.writerow([str(num_clusters)])
+        for cid in range(num_clusters):
+            for _ in range(docs_per_cluster):
+                row = [str(cid)] + [str(rng.randint(lo, hi)) for _ in range(slots)]
+                w.writerow(row)
+
+
+def write_queries(path: str, *, num_queries: int, num_clusters: int,
+                  slots: int, slot_bits: int, seed: int) -> None:
+    rng = random.Random(seed + 1)
+    lo = -(1 << (slot_bits - 1))
+    hi = (1 << (slot_bits - 1))
+    with open(path, "w", newline="") as f:
+        w = csv.writer(f)
+        for qid in range(num_queries):
+            cid = qid % num_clusters
+            row = [str(qid), str(cid)] + [str(rng.randint(lo, hi)) for _ in range(slots)]
+            w.writerow(row)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out-dir", required=True)
+    p.add_argument("--num-clusters", type=int, default=4)
+    p.add_argument("--docs-per-cluster", type=int, default=64)
+    p.add_argument("--slots", type=int, default=192)
+    p.add_argument("--slot-bits", type=int, default=5)
+    p.add_argument("--num-queries", type=int, default=4)
+    p.add_argument("--seed", type=int, default=42)
+    args = p.parse_args()
+
+    os.makedirs(args.out_dir, exist_ok=True)
+    emb = os.path.join(args.out_dir, "emb.csv")
+    qrs = os.path.join(args.out_dir, "queries.csv")
+    write_emb(emb, num_clusters=args.num_clusters,
+              docs_per_cluster=args.docs_per_cluster,
+              slots=args.slots, slot_bits=args.slot_bits, seed=args.seed)
+    write_queries(qrs, num_queries=args.num_queries,
+                  num_clusters=args.num_clusters,
+                  slots=args.slots, slot_bits=args.slot_bits, seed=args.seed)
+    print(f"emb:     {emb}")
+    print(f"queries: {qrs}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/cmd/paired-runner/main.go b/cmd/paired-runner/main.go
