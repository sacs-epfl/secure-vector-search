# Tiptoe Go reference — Secure Vector Search additions
#
# Apply against the upstream commit pinned in tools/tiptoe-go-rev:
#     git clone https://github.com/ahenzinger/tiptoe.git
#     cd tiptoe && git checkout ba7cae43ab8686328897aabd3b7f861622d8ac8a
#     git apply path/to/tools/tiptoe-go.patch
#     go mod download && go build ./cmd/paired-runner/
#
# Hunks:
#   - go.mod / go.sum            : timestamp fix on the underhood pseudo-version
#                                   so `go mod download` succeeds on Go 1.21+
#                                   (the upstream timestamp predates the actual
#                                   VCS commit time and is rejected by the
#                                   strict pseudo-version check).
#   - search/corpus/             : ReadEmbeddingsClusteredCsv — additive reader
#     read_clustered.go            for an externally-clustered embeddings CSV
#                                   (the IVF assignment is computed by the Rust
#                                   scorer-tiptoe port and passed in).
#   - cmd/paired-runner/         : standalone Go binary that drives the
#     main.go                      in-process server+client over the supplied
#                                   IVF clustering, emitting per-query top-k
#                                   hits + offline/online timing + byte counts.
#                                   Driven by eval-harness/bin/tiptoe_go_runner.rs
#                                   for the validation gate.
#   - cmd/paired-runner/         : smoke-test helpers (synthetic clustered
#     gen_smoke.py, check_smoke.py  corpus generation + plaintext-IP score check).
#                                   Not used in production paths; documentation.
#
diff --git a/cmd/paired-runner/check_smoke.py b/cmd/paired-runner/check_smoke.py
new file mode 100644
index 0000000..eaa5e8e
--- /dev/null
+++ b/cmd/paired-runner/check_smoke.py
@@ -0,0 +1,88 @@
+"""Verify paired-runner output against plaintext inner products.
+
+Reads the same emb.csv and queries.csv used to drive the runner, computes the
+ground-truth top-k from int8 inner products within each query's cluster, and
+checks that the runner's score is exactly equal (no LWE-noise tolerance: the
+crypto answer should be bit-identical to plaintext if parameters fit)."""
+import argparse
+import csv
+import sys
+
+
+def load_emb(path):
+    with open(path) as f:
+        r = csv.reader(f)
+        num_docs = int(next(r)[0])
+        slots = int(next(r)[0])
+        slot_bits = int(next(r)[0])
+        num_clusters = int(next(r)[0])
+        clusters = {c: [] for c in range(num_clusters)}
+        for row in r:
+            cid = int(row[0])
+            emb = [int(x) for x in row[1:]]
+            assert len(emb) == slots
+            clusters[cid].append(emb)
+        return clusters, slots, num_clusters
+
+
+def load_queries(path):
+    out = []
+    with open(path) as f:
+        r = csv.reader(f)
+        for row in r:
+            qid = int(row[0])
+            cid = int(row[1])
+            emb = [int(x) for x in row[2:]]
+            out.append((qid, cid, emb))
+    return out
+
+
+def load_out(path):
+    by_q = {}
+    with open(path) as f:
+        r = csv.reader(f)
+        next(r)  # header
+        for row in r:
+            qid, rank, idx, score = map(int, row)
+            by_q.setdefault(qid, []).append((rank, idx, score))
+    for qid in by_q:
+        by_q[qid].sort()
+    return by_q
+
+
+def inner(a, b):
+    return sum(x * y for x, y in zip(a, b))
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out-dir", required=True)
+    args = p.parse_args()
+
+    clusters, _slots, _nc = load_emb(f"{args.out_dir}/emb.csv")
+    queries = load_queries(f"{args.out_dir}/queries.csv")
+    runner = load_out(f"{args.out_dir}/out.csv")
+
+    fail = 0
+    for qid, cid, qemb in queries:
+        true_scores = [(i, inner(d, qemb)) for i, d in enumerate(clusters[cid])]
+        true_scores.sort(key=lambda t: -t[1])
+
+        runner_hits = runner[qid]
+        for rank, (true_idx, true_score) in enumerate(true_scores[:len(runner_hits)]):
+            r_rank, r_idx, r_score = runner_hits[rank]
+            if (rank, true_idx, true_score) != (r_rank, r_idx, r_score):
+                print(f"MISMATCH qid={qid} rank={rank}: "
+                      f"plaintext=({true_idx},{true_score}) runner=({r_idx},{r_score})")
+                fail += 1
+        if fail == 0:
+            print(f"qid={qid} cluster={cid} top-1=doc{runner_hits[0][1]} score={runner_hits[0][2]} OK")
+
+    if fail:
+        print(f"\n{fail} mismatches", file=sys.stderr)
+        sys.exit(1)
+    print("\nALL OK — runner scores match plaintext inner products bit-for-bit")
+
+
+if __name__ == "__main__":
+    main()
