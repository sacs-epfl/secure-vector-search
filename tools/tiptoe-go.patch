index 0000000..8d3cdf3
--- /dev/null
+++ b/cmd/paired-runner/main.go
@@ -0,0 +1,229 @@
+// Command paired-runner drives the in-process Tiptoe Go reference
+// (server + client, no TCP) over an externally-provided IVF clustering
+// of int8-quantised embeddings, emitting per-query top-k hits and
+// timing/byte counters as CSVs. It is the Go side of the validation
+// gate against the Rust port in scorer-tiptoe.
+//
+// Driver: eval-harness/bin/tiptoe_go_runner.rs.
+package main
+
+import (
+  "encoding/csv"
+  "flag"
+  "fmt"
+  "io"
+  "os"
+  "sort"
+  "strconv"
+  "time"
+)
+
+import (
+  "github.com/henrycg/simplepir/matrix"
+  "github.com/henrycg/simplepir/pir"
+  "github.com/ahenzinger/underhood/underhood"
+)
+
+import (
+  "github.com/ahenzinger/tiptoe/search/config"
+  "github.com/ahenzinger/tiptoe/search/corpus"
+  "github.com/ahenzinger/tiptoe/search/protocol"
+  "github.com/ahenzinger/tiptoe/search/utils"
+)
+
+// In-process underhood server pair. Lifted verbatim from
+// search/protocol/embeddings_test.go; this is the standard pattern for
+// driving the offline phase without a coordinator.
+type testServer struct {
+  emb *underhood.Server[matrix.Elem64]
+}
+
+func setupTestServer(h *protocol.TiptoeHint) *testServer {
+  out := new(testServer)
+  if !h.EmbeddingsHint.IsEmpty() {
+    out.emb = underhood.NewServerHintOnly(&h.EmbeddingsHint.Hint)
+  }
+  return out
+}
+
+func applyHint(s *testServer, hq *underhood.HintQuery) *protocol.UnderhoodAnswer {
+  out := new(protocol.UnderhoodAnswer)
+  if s.emb != nil {
+    out.EmbAnswer = *s.emb.HintAnswer(hq)
+  }
+  return out
+}
+
+type query struct {
+  id        uint64
+  clusterID uint64
+  emb       []int8
+}
+
+func readQueriesCsv(path string, dim, slotBits uint64) []query {
+  f, err := os.Open(path)
+  if err != nil {
+    panic(err)
+  }
+  defer f.Close()
+
+  r := csv.NewReader(f)
+  var qs []query
+  for {
+    row, err := r.Read()
+    if err == io.EOF {
+      break
+    } else if err != nil {
+      panic(err)
+    }
+    if uint64(len(row)) != 2+dim {
+      panic(fmt.Sprintf("queries CSV row: expected %d columns, got %d", 2+dim, len(row)))
+    }
+
+    qid, err := strconv.ParseUint(row[0], 10, 64)
+    if err != nil {
+      panic("Error parsing query_id: " + err.Error())
+    }
+    cid, err := strconv.ParseUint(row[1], 10, 64)
+    if err != nil {
+      panic("Error parsing cluster_id: " + err.Error())
+    }
+
+    emb := make([]int8, dim)
+    for i := uint64(0); i < dim; i++ {
+      v, err := strconv.Atoi(row[2+i])
+      if err != nil {
+        panic("Error parsing query slot: " + err.Error())
+      }
+      emb[i] = clamp(v, slotBits)
+    }
+    qs = append(qs, query{id: qid, clusterID: cid, emb: emb})
+  }
+  return qs
+}
+
+// clamp mirrors embeddings.Clamp without depending on the embeddings
+// package (which pulls in a python-process helper at import time).
+func clamp(v int, slotBits uint64) int8 {
+  min := -int(1 << (slotBits - 1))
+  max := int(1 << (slotBits - 1))
+  if v <= min {
+    return int8(min)
+  }
+  if v > max {
+    return int8(max)
+  }
+  return int8(v)
+}
+
+// smoothResult un-mods a score from Z_p back to a signed int by
+// interpreting the upper half [p/2, p) as negative — matches
+// embeddings.SmoothResult.
+func smoothResult(v, p uint64) int64 {
+  if v > p/2 {
+    return int64(v) - int64(p)
+  }
+  return int64(v)
+}
+
+// argsortDesc returns indices that would sort scores descending in
+// signed (smoothed) order.
+func argsortDesc(scores []uint64, p uint64) []int {
+  idx := make([]int, len(scores))
+  for i := range idx {
+    idx[i] = i
+  }
+  sort.SliceStable(idx, func(a, b int) bool {
+    return smoothResult(scores[idx[a]], p) > smoothResult(scores[idx[b]], p)
+  })
+  return idx
+}
+
+func main() {
+  embCsv := flag.String("emb-csv", "", "clustered embeddings CSV (input)")
+  queriesCsv := flag.String("queries-csv", "", "queries CSV (input)")
+  k := flag.Int("k", 10, "top-k")
+  hintMB := flag.Uint64("hint-mb", 25, "SimplePIR hint size in MB")
+  outCsv := flag.String("out-csv", "", "per-query top-k output CSV")
+  timingCsv := flag.String("timing-csv", "", "per-query timing/bytes output CSV")
+  flag.Parse()
+  if *embCsv == "" || *queriesCsv == "" || *outCsv == "" || *timingCsv == "" {
+    flag.Usage()
+    os.Exit(2)
+  }
+
+  conf := config.MakeConfig("/tmp/", false /* image_search */)
+
+  fmt.Fprintf(os.Stderr, "Loading clustered embeddings from %s\n", *embCsv)
+  corp := corpus.ReadEmbeddingsClusteredCsv(*embCsv)
+  fmt.Fprintf(os.Stderr, "  %d docs, %d slots, %d-bit, %d clusters\n",
+    corp.GetNumDocs(), corp.GetEmbeddingSlots(), corp.GetSlotBits(), corp.NumClusters())
+
+  s := new(protocol.Server)
+  fmt.Fprintf(os.Stderr, "Server preprocess (hint=%dMB)\n", *hintMB)
+  s.PreprocessEmbeddingsFromCorpus(corp, *hintMB, conf)
+
+  var h protocol.TiptoeHint
+  s.GetHint(true, &h)
+  p := h.EmbeddingsHint.Info.P()
+
+  c := protocol.NewClient(false /* no coordinator */)
+  c.Setup(&h)
+  tserv := setupTestServer(&h)
+
+  qs := readQueriesCsv(*queriesCsv, corp.GetEmbeddingSlots(), corp.GetSlotBits())
+  fmt.Fprintf(os.Stderr, "Running %d queries (k=%d)\n", len(qs), *k)
+
+  outF, err := os.Create(*outCsv)
+  if err != nil {
+    panic(err)
+  }
+  defer outF.Close()
+  fmt.Fprintln(outF, "query_id,rank,doc_local_idx,score")
+
+  timF, err := os.Create(*timingCsv)
+  if err != nil {
+    panic(err)
+  }
+  defer timF.Close()
+  fmt.Fprintln(timF, "query_id,offline_us,online_us,offline_up_bytes,offline_down_bytes,online_up_bytes,online_down_bytes")
+
+  for _, q := range qs {
+    // Offline phase: client preprocess + server hint apply.
+    offStart := time.Now()
+    ct := c.PreprocessQuery()
+    uAns := applyHint(tserv, ct)
+    c.ProcessHintApply(uAns)
+    offlineUs := time.Since(offStart).Microseconds()
+    offlineUpB := utils.MessageSizeBytes(*ct)
+    // UnderhoodAnswer is not in utils.MessageSizeBytes' type switch;
+    // size the embeddings sub-message directly (we never set UrlAnswer).
+    offlineDnB := utils.MessageSizeBytes(uAns.EmbAnswer)
+
+    // Online phase: build query, server answer, reconstruct cluster scores.
+    onStart := time.Now()
+    qry := c.QueryEmbeddings(q.emb, q.clusterID)
+    var ans pir.Answer[matrix.Elem64]
+    s.GetEmbeddingsAnswer(qry, &ans)
+    scores := c.ReconstructEmbeddingsWithinCluster(&ans, q.clusterID)
+    onlineUs := time.Since(onStart).Microseconds()
+    onlineUpB := utils.MessageSizeBytes(*qry)
+    onlineDnB := utils.MessageSizeBytes(ans)
+
+    idx := argsortDesc(scores, p)
+    topK := *k
+    if topK > len(idx) {
+      topK = len(idx)
+    }
+    for rank := 0; rank < topK; rank++ {
+      fmt.Fprintf(outF, "%d,%d,%d,%d\n",
+        q.id, rank, idx[rank], smoothResult(scores[idx[rank]], p))
+    }
+
+    fmt.Fprintf(timF, "%d,%d,%d,%d,%d,%d,%d\n",
+      q.id, offlineUs, onlineUs,
+      offlineUpB, offlineDnB, onlineUpB, onlineDnB)
+  }
+
+  fmt.Fprintln(os.Stderr, "done")
+}
