diff --git a/search/corpus/read_clustered.go b/search/corpus/read_clustered.go
new file mode 100644
index 0000000..9736046
--- /dev/null
+++ b/search/corpus/read_clustered.go
@@ -0,0 +1,124 @@
+package corpus
+
+import (
+  "io"
+  "os"
+  "fmt"
+  "strconv"
+  "encoding/csv"
+)
+
+import (
+  "github.com/ahenzinger/tiptoe/search/utils"
+  "github.com/ahenzinger/tiptoe/search/embeddings"
+)
+
+// ReadEmbeddingsClusteredCsv reads a CSV produced by an external IVF
+// pipeline (e.g. the Rust scorer-tiptoe port) and returns a Corpus whose
+// embeddingsClusterMap reflects the supplied clustering, exactly as
+// ReadEmbeddingsTxt would for the upstream pre-clustered text format.
+//
+// File layout:
+//   line 1:  numDocs
+//   line 2:  embeddingSlots
+//   line 3:  slotBits
+//   line 4:  numClusters
+//   then one row per document:
+//       <cluster_id>,<int8 slot 0>,<int8 slot 1>,...,<int8 slot D-1>
+//
+// Rows MUST be sorted by cluster_id ascending. Cluster ids must form a
+// contiguous range [0, numClusters-1] with no gaps (mirrors the
+// upstream invariants in NumDocsInCluster).
+func ReadEmbeddingsClusteredCsv(file string) *Corpus {
+  f := utils.OpenFile(file)
+  defer f.Close()
+
+  c := new(Corpus)
+  reader, numDocs, embeddingSlots, slotBits, numClusters := parseClusteredCsvHeader(f)
+  c.params.NumDocs = numDocs
+  c.params.EmbeddingSlots = embeddingSlots
+  c.params.SlotBits = slotBits
+  c.params.checkParams()
+
+  c.embeddings = make([]int8, c.params.EmbeddingSlots*c.params.NumDocs)
+  c.embeddingsClusterMap = make(map[uint]uint, numClusters)
+  c.maxClusterId = uint(numClusters - 1)
+
+  slots := uint(c.params.EmbeddingSlots)
+  prevCluster := int(-1)
+
+  for at := uint(0); ; at++ {
+    row, err := reader.Read()
+    if err == io.EOF {
+      break
+    } else if err != nil {
+      fmt.Printf("%s\n", err)
+      panic("Error reading clustered CSV file")
+    }
+
+    if uint64(len(row)) != 1+c.params.EmbeddingSlots {
+      panic(fmt.Sprintf("Row %d: expected %d columns, got %d",
+        at, 1+c.params.EmbeddingSlots, len(row)))
+    }
+
+    cluster, err := strconv.Atoi(row[0])
+    if err != nil {
+      panic("Error parsing cluster_id")
+    }
+    if cluster < 0 || cluster >= int(numClusters) {
+      panic(fmt.Sprintf("Row %d: cluster_id %d out of range [0,%d)",
+        at, cluster, numClusters))
+    }
+    if cluster < prevCluster {
+      panic(fmt.Sprintf("Row %d: rows must be sorted by cluster_id (saw %d after %d)",
+        at, cluster, prevCluster))
+    }
+    if cluster != prevCluster {
+      // First row of a new cluster: record its starting offset.
+      c.embeddingsClusterMap[uint(cluster)] = at * slots
+      prevCluster = cluster
+    }
+
+    offset := at * slots
+    for i := uint(0); i < slots; i++ {
+      v, err := strconv.Atoi(row[1+i])
+      if err != nil {
+        panic("Error parsing CSV embedding slot")
+      }
+      c.embeddings[offset+i] = embeddings.Clamp(v, c.params.SlotBits)
+    }
+  }
+
+  if uint64(len(c.embeddingsClusterMap)) != numClusters {
+    panic(fmt.Sprintf("Expected %d non-empty clusters, got %d (gaps not allowed)",
+      numClusters, len(c.embeddingsClusterMap)))
+  }
+
+  return c
+}
+
+func parseClusteredCsvHeader(f *os.File) (
+  *csv.Reader, uint64, uint64, uint64, uint64) {
+  var _ io.Reader = f
+  reader := csv.NewReader(f)
+  reader.FieldsPerRecord = -1 // header rows are short
+
+  l1, e1 := reader.Read()
+  l2, e2 := reader.Read()
+  l3, e3 := reader.Read()
+  l4, e4 := reader.Read()
+  if e1 != nil || e2 != nil || e3 != nil || e4 != nil {
+    panic("Error reading clustered CSV header")
+  }
+
+  numDocs, e1 := strconv.Atoi(l1[0])
+  embeddingSlots, e2 := strconv.Atoi(l2[0])
+  slotBits, e3 := strconv.Atoi(l3[0])
+  numClusters, e4 := strconv.Atoi(l4[0])
+  if e1 != nil || e2 != nil || e3 != nil || e4 != nil {
+    panic("Error parsing clustered CSV header")
+  }
+
+  reader.FieldsPerRecord = 0 // re-enable equal-field-count check for body rows
+  return reader, uint64(numDocs), uint64(embeddingSlots), uint64(slotBits), uint64(numClusters)
+}
